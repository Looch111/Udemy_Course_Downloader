# ─────────────────────────────────────────────────────────────────────────────
# Udemy Course Downloader — Environment Configuration
# ─────────────────────────────────────────────────────────────────────────────
# Copy this file to .env and fill in your values.
# ALL fields are optional — the tool auto-detects credentials from your browser.
#
# AUTH PRIORITY: Bearer Token > Cookie String > Cookie File > Browser Auto-Extract
# ─────────────────────────────────────────────────────────────────────────────

# ── Authentication (choose one — or leave blank for auto-extraction) ──────────

# Option A: Bearer Token (most stable)
# Get this from: DevTools → Network → any api-2.0 request → Authorization header
ACCESS_TOKEN=

# Option B: Raw cookie string from your browser
# Get this from: DevTools → Application → Cookies → copy all as "name=val; ..."
COOKIE_STRING=

# Option C: Path to a Netscape cookies.txt file
# Export from: "Get cookies.txt LOCALLY" browser extension
COOKIE_FILE=

# ── Output ────────────────────────────────────────────────────────────────────

OUTPUT_DIR=./downloads

# ── Logging ───────────────────────────────────────────────────────────────────

# error | warn | info | debug
LOG_LEVEL=info
